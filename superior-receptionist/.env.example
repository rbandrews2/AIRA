ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+18446857207

PORT=3000
PUBLIC_URL=https://your-public-url.example

# AIRA settings
AIRA_VOICE=Polly.Joanna-Neural
AIRA_TRANSFER_NUMBER=+15407970405

# Keep false unless you have consent language and jurisdiction-specific approval.
AIRA_RECORD_CALLS=false

# Supabase Edge Function deployment uses these in Supabase, not in the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Required when the Express backend writes to owner-scoped Supabase tables.
AIRA_OWNER_ID=your_supabase_auth_user_uuid

# Optional. When set, Express asks the deployed Edge Function for assistant replies.
AIRA_ASSISTANT_FUNCTION_URL=

# Live voice model via signed requests to the Netlify gateway function.
# Uses TWILIO_AUTH_TOKEN for request authentication; never expose it in a browser.
AIRA_GATEWAY_URL=https://aira.superiorllc.org/api/phone-reply

# Private dashboard API access; generate a long random token. Never commit it.
AIRA_OPERATOR_TOKEN=
# Set to the exact dashboard origin in production.
AIRA_ALLOWED_ORIGIN=https://your-dashboard.example
# Use a persistent disk for locally saved messages.
AIRA_DATA_DIR=./data
# Local signed-webhook bypass is loopback-only and forbidden in production.
AIRA_LOCAL_TEST=false
